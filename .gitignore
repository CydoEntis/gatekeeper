# Locally downloaded Go toolchain, so the repo builds without a system install
.toolchain/

# Built binaries
/gk
/gk.exe
*.exe
/dist/

# Plaintext exports must never be committed
.env
.env.*
!.env.example

# Private identities never belong in the synchronized directory
*.key
identities/

# Transient encrypted-write files
.tmp-*
*.tmp

# Editor and OS noise
.DS_Store
Thumbs.db

# Test artifacts
coverage.out
